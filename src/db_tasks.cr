# `crails db:*` — migrate / rollback / schema:dump / schema:load.
#
# Crystal cannot load .cr files at runtime, so the tasks generate a small
# runner (tmp/db_runner.cr) that requires every db/migrate/*.cr explicitly,
# then compile & run it via `crystal run`. The runner connects through
# DATABASE_URL / config/database.yml (same rules as the app), runs the
# Migrator, and refreshes db/schema.cr (the Rails schema.rb analog, dumped
# 1:1) plus db/schema.yml (the model-codegen fallback) — matching the Rails
# dev loop (`crails db:migrate && crails watch`).

module CRails
  module CLI
    module DB
      def self.run(argv : Array(String)) : Nil
        # accept both "db migrate" and the Rails-style "db:migrate"
        task = argv[0]? || "help"
        task = task.split(':', 2)[1]? || "help" if task.starts_with?("db:")
        rest = task == argv[0]? ? argv[1..] : argv
        case task
        when "migrate"     then Build.ensure_app; runner("up", step: 0, dump: true)
        when "rollback"    then Build.ensure_app; runner("down", step: step_arg(rest), dump: true)
        when "schema:dump" then Build.ensure_app; runner("up", step: 0, dump: true, migrate: false)
        when "schema:load" then Build.ensure_app; load_schema
        when "help", "-h"  then help
        else
          STDERR.puts "Unknown db task: #{task}"
          help
          exit 1
        end
      end

      private def self.step_arg(argv : Array(String)) : Int32
        argv.each_with_index do |a, i|
          if a == "STEP"
            return argv[i + 1]?.try(&.to_i) || 1
          elsif a.starts_with?("STEP=")
            return a.split('=', 2)[1].to_i
          end
        end
        1
      end

      private def self.help : Nil
        puts <<-TEXT
          Usage: crails db:TASK

          Tasks:
            migrate       Run pending migrations in db/migrate/ (dumps db/schema.cr + db/schema.yml after)
            rollback      Roll back the last migration (STEP=n for n migrations)
            schema:dump   Refresh db/schema.cr and db/schema.yml from the database
            schema:load   Recreate the database from db/schema.cr (no migrations run)
        TEXT
      end

      # --- generated runner -------------------------------------------------

      def self.migration_files : Array(String)
        Dir.glob("db/migrate/*.cr").sort
      end

      def self.class_name_for(file : String) : String
        stem = File.basename(file, ".cr")
        stem = stem.split('_', 2)[1]? || stem   # strip version prefix
        stem.split('_').map(&.capitalize).join
      end

      def self.version_for(file : String) : Int64
        File.basename(file, ".cr").split('_', 2)[0].to_i64
      end

      def self.runner(direction : String, step : Int32, dump : Bool, migrate : Bool = true) : Nil
        files = migration_files
        abort "ERROR: no migrations in db/migrate/ (crails generate migration NAME)" if migrate && files.empty?

        requires = files.map { |f| %(require "../#{f}") }.join("\n")
        entries = files.map do |f|
          version = version_for(f)
          klass = class_name_for(f)
          "  {#{version}_i64, #{klass}.new(#{version}_i64)},"
        end.join("\n")

        migrator_block = migrate ? <<-CODE : ""
          direction = (ENV["CRAILS_DB_DIRECTION"]? || "up") == "down" ? :down : :up
          step = (ENV["CRAILS_DB_STEP"]? || "0").to_i
          migrations = [
          #{entries}
          ] of {Int64, ActiveRecord::Migration}
          ActiveRecord::Migrator.new(direction, migrations.map(&.[1]), step).migrate
        CODE
        dump_block = dump ? <<-CODE : ""
          n = ActiveRecord::SchemaDumper.dump_cr_to_file("db/schema.cr")
          puts "dumped \#{n} tables -> db/schema.cr"
          ActiveRecord::SchemaDumper.dump_to_file("db/schema.yml")
          puts "dumped db/schema.yml (model codegen input)"
        CODE

        code = <<-CODE
        # Generated by `crails db:*` — do not edit.
        require "active_record_cr"

        if (url = ENV["DATABASE_URL"]?)
          ActiveRecord::Base.establish_connection(url)
        elsif File.exists?("config/database.yml")
          ActiveRecord::Base.establish_connection_from_yaml(
            "config/database.yml", ENV["CRAILS_ENV"]? || "development")
        else
          abort "config/database.yml or DATABASE_URL required"
        end

        #{requires}

        #{migrator_block}
        #{dump_block}
        CODE

        Dir.mkdir_p("tmp")
        File.write("tmp/db_runner.cr", code)

        env = ENV.to_h.merge({
          "CRAILS_DB_DIRECTION" => direction,
          "CRAILS_DB_STEP"      => step.to_s,
        })
        puts "==> crystal run tmp/db_runner.cr"
        ok = Process.run("crystal", ["run", "tmp/db_runner.cr"], env: env)
        exit(ok.success? ? 0 : 1)
      end

      # `crails db:schema:load` — recreate the schema from db/schema.cr
      # (the Rails db:schema:load analog). Compiles a tiny runner that
      # requires the dumped DSL file; ActiveRecord::Schema[8.1].define
      # executes it and assumes the dumped version in schema_migrations.
      private def self.load_schema : Nil
        abort "ERROR: db/schema.cr not found (run crails db:schema:dump first)" unless File.exists?("db/schema.cr")

        code = <<-CODE
        # Generated by `crails db:schema:load` — do not edit.
        require "active_record_cr"

        if (url = ENV["DATABASE_URL"]?)
          ActiveRecord::Base.establish_connection(url)
        elsif File.exists?("config/database.yml")
          ActiveRecord::Base.establish_connection_from_yaml(
            "config/database.yml", ENV["CRAILS_ENV"]? || "development")
        else
          abort "config/database.yml or DATABASE_URL required"
        end

        require "../db/schema"
        CODE

        Dir.mkdir_p("tmp")
        File.write("tmp/db_schema_load.cr", code)
        puts "==> crystal run tmp/db_schema_load.cr"
        ok = Process.run("crystal", ["run", "tmp/db_schema_load.cr"])
        exit(ok.success? ? 0 : 1)
      end
    end
  end
end

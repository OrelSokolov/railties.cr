# CRails::CLI::Supervisor — `crails supervise`: процесс-супервизор ролей
# приложения (аналог foreman + Solid Queue supervisor в Rails 8:
# один PID на весь процесс-лес, web/worker/scheduler стартуют из Procfile).
#
# Procfile (пишется `crails new`, формат foreman):
#   web:       bin/app serve
#   worker:    bin/app worker
#   scheduler: bin/app scheduler
#
# Поведение:
#   * каждая роль запускается через sh -c (output → STDOUT/STDERR);
#   * упавшая роль перезапускается с backoff 1s → 2s → 5s (макс);
#   * роль, завершившаяся с exit 3 (CRails_ROLE_NOT_COMPILED),
#     помечается disabled и больше не стартует (web-приложение без
#     джобов просто игнорирует worker/scheduler);
#   * SIGINT/SIGTERM → TERM всем детям, ждём завершения, выходим.
module CRails
  module CLI
    module Supervisor
      NOT_COMPILED_EXIT = 3
      TICK              = 500.milliseconds
      MAX_BACKOFF       = 5.seconds

      class Role
        getter name : String
        getter command : String
        property process : Process?
        property? disabled : Bool = false
        property backoff : Time::Span = 1.second
        property next_restart : Time::Instant?

        def initialize(@name, @command)
        end
      end

      def self.run(argv : Array(String)) : Nil
        procfile = argv[0]? || "Procfile"
        only = argv[1]? # опционально: одна роль (crails supervise Procfile web)

        unless File.exists?(procfile)
          abort "ERROR: no #{procfile} in #{Dir.current} (generated by `crails new`)"
        end
        roles = parse_procfile(procfile)
        abort "ERROR: #{procfile} has no roles" if roles.empty?
        roles = roles.select { |r| r.name == only } if only
        abort "ERROR: role #{only} not found in #{procfile}" if roles.empty?

        stopping = Channel(Nil).new
        Signal::INT.trap { stopping.close }
        Signal::TERM.trap { stopping.close }

        puts "crails supervise: #{roles.map(&.name).join(", ")} (Ctrl-C to stop)"
        roles.each { |role| start(role) }

        loop do
          select
          when stopping.receive?
            break
          when timeout(TICK)
            roles.each do |role|
              next if role.disabled?
              monitor(role)
            end
          end
        end

        puts "crails supervise: stopping roles"
        roles.each do |role|
          if (process = role.process) && !process.terminated?
            process.terminate rescue nil
          end
        end
        roles.each do |role|
          process = role.process
          next unless process
          process.wait unless process.terminated?
        rescue Exception
          # уже завершён или зомби — не фатально
        end
      end

      # --- внутреннее -----------------------------------------------------

      # Умерший процесс: запомнить статус, взвести backoff/рестарт (или
      # disable для exit 3 — роль не скомпилирована в bin/app).
      private def self.monitor(role : Role) : Nil
        process = role.process
        return unless process && process.terminated?

        # процесс уже terminated — wait немедленно вернёт статус
        status = (process.wait rescue nil)
        if status.try(&.normal_exit?) && status.try(&.exit_code) == NOT_COMPILED_EXIT
          puts "crails supervise: role #{role.name} not compiled in — disabled"
          role.disabled = true
          return
        end

        now = Time.instant
        nr = role.next_restart
        if nr.nil?
          code = status.try(&.normal_exit?) ? " (code #{status.try(&.exit_code)})" : ""
          puts "crails supervise: role #{role.name} exited#{code} — " \
               "restarting in #{role.backoff.total_seconds}s"
          role.backoff = {role.backoff * 2, MAX_BACKOFF}.min
          role.next_restart = now + role.backoff
        elsif now >= nr
          start(role)
        end
      end

      private def self.start(role : Role) : Nil
        role.next_restart = nil
        role.process = Process.new("sh", ["-c", role.command],
          output: Process::Redirect::Inherit,
          error: Process::Redirect::Inherit)
      rescue File::Error | IO::Error
        puts "crails supervise: cannot start #{role.name} (#{role.command})"
        role.next_restart = Time.instant + role.backoff
      end

      def self.parse_procfile(path : String) : Array(Role)
        roles = [] of Role
        File.read(path).each_line do |line|
          next if line.blank? || line.starts_with?('#')
          name, command = line.split(':', 2)
          roles << Role.new(name.strip, command.strip) unless command.strip.empty?
        end
        roles
      rescue File::Error
        abort "ERROR: cannot read #{path}"
      end
    end
  end
end

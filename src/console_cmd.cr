require "icr"

# `crails console` / `crails c` — rails console analog on top of icr.cr
# (https://github.com/OrelSokolov/icr.cr).
#
# The app is loaded through the generated src/console.cr prelude
# (requires the app, connects the database), and every REPL line is
# submitted to an Icr session:
#   - replay backend (default): whole session recompiled per line via
#     `crystal run` — works with the stock compiler (~seconds per line),
#   - live backend (CRAILS_CONSOLE_LIVE=1): persistent `crystal i`
#     interpreter — instant answers, needs an interpreter-enabled
#     crystal (see icr.cr scripts/build-interpreter.sh).
module CRails
  module CLI
    module Console
      def self.run(args : Array(String)) : Nil
        Build.ensure_app

        env = "development"
        i = 0
        while i < args.size
          case args[i]
          when "-e", "--env" then env = args[i + 1]; i += 2
          else
            abort "ERROR: unknown option #{args[i]}"
          end
        end
        ENV["CRAILS_ENV"] = env

        io : Icr::LiveSession | Icr::ReplaySession
        mode : String
        if ENV["CRAILS_CONSOLE_LIVE"]? == "1"
          # Live interpreter (`crystal i` over a PTY): instant per line,
          # but the whole-app prelude may exceed icr's 30s submit
          # deadline — opt-in until that is verified.
          bin = Icr.interpreter_bin || "crystal"
          # cwd must be the app dir: the prelude is a cwd-relative
          # require, and LiveSession defaults to the compiler's own
          # bin directory.
          io = Icr::LiveSession.new(bin, Dir.current)
          mode = "live interpreter"
        else
          # Replay default: every line recompiles the whole session via
          # `crystal run` — works with the stock compiler (~seconds per
          # line, state persists by replay).
          io = Icr::ReplaySession.new
          mode = "replay, recompiles per line"
        end

        # Replay compiles each line into a temp file outside the app, and
        # Crystal resolves absolute `require "/x"` against CRYSTAL_PATH
        # roots — so the app is loaded through a shim inside lib/.
        # The backends resolve the shim differently: replay via the
        # cwd's lib/ (bare shard-style name), the live interpreter via
        # a cwd-relative path.
        Dir.mkdir_p("lib")
        File.write("lib/crails_boot.cr",
          %(# generated by `crails console` — loads the app\nrequire "../src/console"\n))
        prelude = io.is_a?(Icr::LiveSession) ? %(require "./lib/crails_boot") : %(require "crails_boot")

        puts "Loading #{env} environment (CRails #{CRails::VERSION}, Crystal #{Crystal::VERSION}, icr #{Icr::VERSION} — #{mode})"

        boot = io.submit(prelude)
        # The prelude require produces no output on success; a live
        # session renders it as "=> nil". Anything else is an app-load
        # error.
        if (msg = boot.presence) && msg != "=> nil"
          STDERR.puts msg
          STDERR.puts "ERROR: could not load the application (see above)"
          io.close if io.is_a?(Icr::LiveSession)
          exit 1
        end

        short_env = case env
                    when "development" then "dev"
                    when "production"  then "prod"
                    else env
                    end
        puts "Type \"exit\" to leave · \".reset\" to clear · \".program\" to list the session"

        # icr's own line editor (the standalone icr CLI uses): ↑/↓
        # history, ←/→ editing, Tab completion, ^T search. Falls back to
        # a plain gets when stdin is not a TTY (piped input).
        editor = Icr::LineEditor.new(Icr::Completion::Index.default)
        history = [] of String

        loop do
          prompt = io.is_a?(Icr::LiveSession) && io.needs_continuation? ? "... > " : "crails(#{short_env})> "
          line = editor.read_line(prompt, history)
          break if line.nil? # Ctrl+D
          line = line.strip
          next if line.empty?

          unless io.is_a?(Icr::LiveSession)
            # Multi-line input in replay mode: end a line with '\'.
            while line.ends_with?('\\')
              more = editor.read_line("... > ", history)
              break if more.nil?
              line = line.rchop + "\n" + more
            end
          end

          case line
          when ".exit", ".quit", "exit", "exit!" then break
          when ".reset"   then puts io.reset
          when ".program" then puts io.program_source.presence || "# (empty)"
          else
            started = Time.instant
            result = io.submit(line)
            elapsed = Time.instant - started
            puts result.presence || "# (no output)"
            printf("# %.1fs\n", elapsed.total_seconds)
            history << line unless history.last? == line
            break if io.is_a?(Icr::LiveSession) && !io.alive?
          end
        end

        puts
        editor.close
        io.close if io.is_a?(Icr::LiveSession)
      end
    end
  end
end
